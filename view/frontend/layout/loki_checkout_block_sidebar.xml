<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Loki Checkout shows the gift card total by itself; the cart form is posted as a plain form -->
        <referenceBlock name="loki-checkout.sidebar.summary">
            <block class="Magento\Checkout\Block\Cart\AbstractCart" name="loki-checkout.sidebar.giftcard"
                   after="loki-checkout.sidebar.coupon_code" template="MageOS_GiftCard::cart/giftcard.phtml">
                <arguments>
                    <argument name="checkout" xsi:type="boolean">true</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
