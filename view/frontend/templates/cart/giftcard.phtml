<?php
declare(strict_types=1);

/** @var \Magento\Checkout\Block\Cart\AbstractCart $block */
/** @var \Magento\Framework\Escaper $escaper */

$code = (string) $block->getQuote()->getData('giftcard_code');
?>
<details class="block giftcard-form group"<?= $code !== '' ? ' open' : '' ?>>
    <summary class="title list-none flex justify-between items-center gap-2 py-2 font-semibold">
        <strong class="font-semibold"><?= $escaper->escapeHtml(__('Apply Gift Card')) ?></strong>
    </summary>
    <form class="mt-2 mb-4" action="<?= $escaper->escapeUrl($block->getUrl('giftcard/cart/apply')) ?>" method="post">
        <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>
        <label for="giftcard_code" class="label sr-only">
            <?= $escaper->escapeHtml(__('Enter gift card code')) ?>
        </label>
        <div class="fieldset space-y-2">
            <input type="text" id="giftcard_code" name="giftcard_code" class="input-text form-input w-full"
                   value="<?= $escaper->escapeHtmlAttr($code) ?>"
                   placeholder="<?= $escaper->escapeHtmlAttr(__('Enter gift card code')) ?>"
                   <?= $code !== '' ? 'disabled' : 'required' ?>>
            <?php if ($code !== ''): ?>
                <input type="hidden" name="remove" value="1">
                <button type="submit" class="action primary btn btn-secondary w-full">
                    <?= $escaper->escapeHtml(__('Remove Gift Card')) ?>
                </button>
            <?php else: ?>
                <button type="submit" class="action primary btn btn-secondary w-full">
                    <?= $escaper->escapeHtml(__('Apply Gift Card')) ?>
                </button>
            <?php endif; ?>
        </div>
    </form>
</details>
