                    implode(', ', \MageOS\GiftCard\Model\AdminCards::COLUMNS)
                )) ?>
            </div>
        </div>
    </div>
    <div class="admin__field">
        <div class="admin__field-control">
            <button type="submit" class="action-primary"><?= $escaper->escapeHtml(__('Create Gift Cards')) ?></button>
            <div class="admin__field-note">
                <?= $escaper->escapeHtml(__(
                    'All cards are created, or none. With the right to see full codes, their list is downloaded.'
                )) ?>
