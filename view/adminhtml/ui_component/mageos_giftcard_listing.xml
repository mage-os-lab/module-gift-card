<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mageos_giftcard_listing.mageos_giftcard_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add Gift Card</label>
            </button>
        </buttons>
        <spinner>mageos_giftcard_columns</spinner>
        <deps>
            <dep>mageos_giftcard_listing.mageos_giftcard_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="mageos_giftcard_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">giftcard_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MageOS_GiftCard::cards</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="mageos_giftcard_listing_data_source">
            <settings>
                <requestFieldName>giftcard_id</requestFieldName>
                <primaryFieldName>giftcard_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <exportButton name="export_button"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="mageos_giftcard_columns">
        <settings>
            <editorConfig>
                <param name="clientConfig" xsi:type="array">
                    <item name="saveUrl" xsi:type="url" path="mageos_giftcard/card/inlineEdit"/>
                    <item name="validateBeforeSave" xsi:type="boolean">false</item>
                </param>
                <param name="indexField" xsi:type="string">giftcard_id</param>
                <param name="enabled" xsi:type="boolean">true</param>
                <param name="selectProvider" xsi:type="string">mageos_giftcard_listing.mageos_giftcard_listing.mageos_giftcard_columns.ids</param>
            </editorConfig>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">mageos_giftcard_listing.mageos_giftcard_listing.mageos_giftcard_columns_editor</item>
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids">
            <settings>
                <indexField>giftcard_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="giftcard_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="code" sortOrder="20">
            <settings>
                <filter>text</filter>
                <sortable>false</sortable>
                <label translate="true">Code</label>
            </settings>
        </column>
        <column name="initial_balance" class="MageOS\GiftCard\Ui\Component\Listing\Column\Balance" sortOrder="30">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Initial Balance</label>
            </settings>
        </column>
        <column name="balance" class="MageOS\GiftCard\Ui\Component\Listing\Column\Balance" sortOrder="40">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Balance</label>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="MageOS\GiftCard\Model\Source\Status"/>
                <filter>select</filter>
                <editor>
                    <editorType>select</editorType>
                </editor>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="expires_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="55">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <editor>
                    <editorType>date</editorType>
                </editor>
                <dateFormat>MMM d, y</dateFormat>
                <label translate="true">Expires</label>
            </settings>
        </column>
        <column name="recipient_email" sortOrder="58">
            <settings>
                <filter>text</filter>
                <label translate="true">Recipient</label>
            </settings>
        </column>
        <column name="recipient_name" sortOrder="59">
            <settings>
                <filter>text</filter>
                <label translate="true">Recipient Name</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="sender_name" sortOrder="59">
            <settings>
                <filter>text</filter>
                <label translate="true">Sender Name</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="send_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="59">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Send On</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="sent_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="59">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">E-mailed</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="customer_email" sortOrder="59">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer</label>
            </settings>
        </column>
        <column name="increment_id" class="MageOS\GiftCard\Ui\Component\Listing\Column\Order" sortOrder="60">
            <settings>
                <filter>text</filter>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Bought In</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="70">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="MageOS\GiftCard\Ui\Component\Listing\Column\Actions" sortOrder="100">
            <settings>
                <indexField>giftcard_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
