<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mageos_giftcard_history_listing.mageos_giftcard_history_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="back">
                <url path="*/*/"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
        </buttons>
        <spinner>mageos_giftcard_history_columns</spinner>
        <deps>
            <dep>mageos_giftcard_history_listing.mageos_giftcard_history_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="mageos_giftcard_history_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">history_id</param>
            </storageConfig>
            <filterUrlParams>
                <param name="giftcard_id">*</param>
            </filterUrlParams>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MageOS_GiftCard::cards</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="mageos_giftcard_history_listing_data_source">
            <settings>
                <requestFieldName>history_id</requestFieldName>
                <primaryFieldName>history_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="mageos_giftcard_history_columns">
        <column name="history_id" sortOrder="5">
            <settings>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="10">
            <settings>
                <dataType>date</dataType>
                <label translate="true">Date</label>
            </settings>
        </column>
        <column name="action" component="Magento_Ui/js/grid/columns/select" sortOrder="20">
            <settings>
                <options class="MageOS\GiftCard\Model\Source\Action"/>
                <dataType>select</dataType>
                <label translate="true">Action</label>
            </settings>
        </column>
        <column name="amount" sortOrder="30">
            <settings>
                <label translate="true">Change</label>
            </settings>
        </column>
        <column name="balance" sortOrder="40">
            <settings>
                <label translate="true">Balance</label>
            </settings>
        </column>
        <column name="order_increment_id" sortOrder="50">
            <settings>
                <label translate="true">Order</label>
            </settings>
        </column>
        <column name="admin_user" sortOrder="60">
            <settings>
                <label translate="true">Admin User</label>
            </settings>
        </column>
        <column name="comment" sortOrder="70">
            <settings>
                <label translate="true">Comment</label>
            </settings>
        </column>
    </columns>
</listing>
