<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="mageos_giftcard" resource="default" engine="innodb" comment="Gift cards">
        <column xsi:type="int" name="giftcard_id" unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="varchar" name="code" length="32" nullable="false" comment="Code"/>
        <column xsi:type="decimal" name="balance" precision="20" scale="4" unsigned="true" nullable="false"
                default="0" comment="Balance in base currency"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="giftcard_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGEOS_GIFTCARD_CODE">
            <column name="code"/>
        </constraint>
    </table>
    <table name="quote" resource="checkout">
        <column xsi:type="varchar" name="giftcard_code" length="32" nullable="true" comment="Gift card code"/>
        <column xsi:type="decimal" name="base_giftcard_amount" precision="20" scale="4" nullable="true"
                comment="Base gift card amount"/>
        <column xsi:type="decimal" name="giftcard_amount" precision="20" scale="4" nullable="true"
                comment="Gift card amount"/>
    </table>
    <table name="sales_order" resource="sales">
        <column xsi:type="varchar" name="giftcard_code" length="32" nullable="true" comment="Gift card code"/>
        <column xsi:type="decimal" name="base_giftcard_amount" precision="20" scale="4" nullable="true"
                comment="Base gift card amount"/>
        <column xsi:type="decimal" name="giftcard_amount" precision="20" scale="4" nullable="true"
                comment="Gift card amount"/>
    </table>
    <table name="sales_invoice" resource="sales">
        <column xsi:type="decimal" name="base_giftcard_amount" precision="20" scale="4" nullable="true"
                comment="Base gift card amount"/>
        <column xsi:type="decimal" name="giftcard_amount" precision="20" scale="4" nullable="true"
                comment="Gift card amount"/>
    </table>
    <table name="sales_creditmemo" resource="sales">
        <column xsi:type="decimal" name="base_giftcard_amount" precision="20" scale="4" nullable="true"
                comment="Base gift card amount"/>
        <column xsi:type="decimal" name="giftcard_amount" precision="20" scale="4" nullable="true"
                comment="Gift card amount"/>
    </table>
</schema>
