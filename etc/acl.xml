<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Sales::sales">
                    <resource id="Magento_Sales::sales_operation">
                        <resource id="MageOS_GiftCard::cards" title="Gift Cards" translate="title" sortOrder="60">
                            <resource id="MageOS_GiftCard::cards_create" title="Create Gift Cards"
                                      translate="title" sortOrder="10"/>
                            <resource id="MageOS_GiftCard::cards_edit" title="Change Balance, Status and Expiry"
                                      translate="title" sortOrder="20"/>
                            <resource id="MageOS_GiftCard::cards_resend" title="E-mail Codes"
                                      translate="title" sortOrder="30"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="MageOS_GiftCard::config" title="Gift Cards" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
