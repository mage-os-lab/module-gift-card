<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_before">
        <observer name="mageos_giftcard_validate_product" instance="MageOS\GiftCard\Observer\ValidateProduct"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="mageos_giftcard_redeem" instance="MageOS\GiftCard\Observer\Redeem"/>
    </event>
    <event name="sales_order_place_before">
        <observer name="mageos_giftcard_redeem" instance="MageOS\GiftCard\Observer\Redeem"/>
    </event>
    <event name="sales_model_service_quote_submit_failure">
        <observer name="mageos_giftcard_restore" instance="MageOS\GiftCard\Observer\Restore"/>
    </event>
    <event name="order_cancel_after">
        <observer name="mageos_giftcard_restore" instance="MageOS\GiftCard\Observer\Restore"/>
    </event>
    <event name="sales_order_save_before">
        <observer name="mageos_giftcard_restore" instance="MageOS\GiftCard\Observer\Restore"/>
    </event>
    <event name="sales_order_creditmemo_refund">
        <observer name="mageos_giftcard_restore" instance="MageOS\GiftCard\Observer\Restore"/>
        <observer name="mageos_giftcard_revoke" instance="MageOS\GiftCard\Observer\Revoke"/>
    </event>
    <event name="catalog_product_type_prepare_full_options">
        <observer name="mageos_giftcard_prepare_options" instance="MageOS\GiftCard\Observer\PrepareOptions"/>
    </event>
    <event name="catalog_product_get_final_price">
        <observer name="mageos_giftcard_apply_amount" instance="MageOS\GiftCard\Observer\ApplyAmount"/>
    </event>
    <event name="sales_order_invoice_pay">
        <observer name="mageos_giftcard_issue" instance="MageOS\GiftCard\Observer\Issue"/>
    </event>
    <event name="sales_order_invoice_save_commit_after">
        <observer name="mageos_giftcard_issue" instance="MageOS\GiftCard\Observer\Issue"/>
    </event>
</config>
