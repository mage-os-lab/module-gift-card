<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Sales:etc/sales.xsd">
    <!-- all three run after grand_total: a gift card is a means of payment, it does not change tax -->
    <section name="quote">
        <group name="totals">
            <item name="giftcard" instance="MageOS\GiftCard\Model\Total\Quote" sort_order="600"/>
        </group>
    </section>
    <section name="order_invoice">
        <group name="totals">
            <item name="giftcard" instance="MageOS\GiftCard\Model\Total\Document" sort_order="400"/>
        </group>
    </section>
    <section name="order_creditmemo">
        <group name="totals">
            <item name="giftcard" instance="MageOS\GiftCard\Model\Total\Document" sort_order="450"/>
        </group>
    </section>
</config>
