<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- every minute, so a gift without a send date leaves right after the invoice -->
        <job name="mageos_giftcard_send_gifts" instance="MageOS\GiftCard\Cron\SendGifts" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <!-- cards a paid invoice did not issue (error, request that died) -->
        <job name="mageos_giftcard_issue_missing" instance="MageOS\GiftCard\Cron\IssueMissing" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <!-- debits of orders that were never saved -->
        <job name="mageos_giftcard_give_back_orphans" instance="MageOS\GiftCard\Cron\GiveBackOrphans"
             method="execute">
            <schedule>23 * * * *</schedule>
        </job>
    </group>
</config>
